{
  "manifest_version": 3,
  "name": "Gemin-Eye Spy Glass",
  "version": "1.0.3",
  "description": "Scan Facebook groups and LinkedIn feeds for high-intent leads. Replaces the bookmarklets — works across multiple tabs.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://www.linkedin.com/*",
    "https://gemin-eye.com/*",
    "https://*.replit.app/*",
    "https://*.replit.dev/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemin-Eye Spy Glass"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://m.facebook.com/*"],
      "js": ["content-facebook.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content-linkedin.js"],
      "run_at": "document_idle"
    }
  ]
}
